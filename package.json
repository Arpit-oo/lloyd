{
  "name": "brand-campaign-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:keys": "tsx --env-file=.env scripts/test-keys.ts",
    "ingest": "tsx --env-file=.env scripts/ingest.ts",
    "brief": "tsx --env-file=.env scripts/run-brief.ts",
    "eval": "node scripts/clean-eval-data.mjs && cross-env DATA_DIR=./data/eval tsx --env-file=.env scripts/eval.ts",
    "bench": "node scripts/clean-eval-data.mjs && cross-env DATA_DIR=./data/eval tsx --env-file=.env scripts/eval.ts --write-costs",
    "seed": "tsx --env-file=.env scripts/make-seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.67.0",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "openai": "^7.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
